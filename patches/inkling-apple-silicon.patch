+kernel void kernel_inkling_situ(
+        constant uint * dims [[buffer(0)]], constant ulong * stride [[buffer(1)]],
+        constant float * params [[buffer(2)]], device const float4 * gates [[buffer(3)]],
+        device const float4 * values [[buffer(4)]], device float4 * dst [[buffer(5)]],
+        uint id [[thread_position_in_grid]]) {
+    #pragma clang fp reassociate(off) contract(off)
+    const uint row = id / dims[0];
+    if (row >= dims[3]) return;
+    const uint col = id % dims[0], i1 = row % dims[1], i2 = (row / dims[1]) % dims[2], i3 = row/(dims[1]*dims[2]);
+    const float4 gate = gates[col + i1*stride[0] + i2*stride[1] + i3*stride[2]];
+    const float4 value = values[col + i1*stride[3] + i2*stride[4] + i3*stride[5]];
+    volatile thread float4 nonlinear = params[0] * precise::tanh(gate * params[2]);
+    volatile thread float4 sigmoid = 1.0f / (1.0f + exp(-gate));
+    volatile thread float4 limited = params[1] > 0 ? params[1] * precise::tanh(value * params[3]) : value;
+    volatile thread float4 scaled = nonlinear * sigmoid;
+    dst[id] = scaled * limited;
+}
