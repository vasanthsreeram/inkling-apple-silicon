+// The stock SUM_ROWS(F32) uses a componentwise float4 SIMD reduction at these widths.
+kernel void kernel_inkling_clip(
+        constant uint * shape [[buffer(0)]], constant float & threshold [[buffer(1)]],
+        device const float4 * x [[buffer(2)]], device float4 * output [[buffer(3)]],
+        uint group [[threadgroup_position_in_grid]], ushort simd [[simdgroup_index_in_threadgroup]],
+        ushort lane [[thread_index_in_simdgroup]]) {
+    const uint row = group * 4 + simd;
+    if (row >= shape[1]) return;
+    const uint pos = row * shape[0] + lane;
+    const float4 v = lane < shape[0] ? x[pos] : float4(0);
+    const float4 squared = v * v;
+    const float total = sum(simd_sum(squared));
+    volatile thread float norm = sqrt(total);
+    volatile thread float denom = norm + 1e-6f;
+    const float factor = clamp(threshold / denom, 0.0f, 1.0f);
+    if (lane < shape[0]) output[pos] = v * factor;
+}
