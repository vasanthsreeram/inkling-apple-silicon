+kernel void kernel_inkling_relative_mask(
+        constant int * args [[buffer(0)]], device const float * table [[buffer(1)]],
+        device const int * ids [[buffer(2)]], device const half * causal [[buffer(3)]],
+        device half * output [[buffer(4)]], uint3 p [[thread_position_in_grid]]) {
+    const uint keys = args[0], queries = args[1], heads = args[2], buckets = args[3];
+    if (p.x >= keys) return;
+    const uint pos = p.y * keys + p.x;
+    const float bias = table[(p.y * heads + p.z) * buckets + uint(ids[pos])];
+    output[(p.z * queries + p.y) * keys + p.x] = half(bias + float(causal[pos]));
+}
+
+// One threadgroup: 128 keys of one query. Each thread reads its bias column once and writes all heads.
+kernel void kernel_inkling_relative_bias_mask(
+        constant int * args [[buffer(0)]], device const float4 * bias [[buffer(1)]],
+        device const float4 * r [[buffer(2)]], device const float * sinks [[buffer(3)]],
+        device const int * ids [[buffer(4)]], device const half * causal [[buffer(5)]],
+        device half * output [[buffer(6)]], uint2 group [[threadgroup_position_in_grid]],
+        uint tid [[thread_index_in_threadgroup]]) {
+    const uint keys = args[0], queries = args[1], heads = args[2], extent = args[3];
+    const uint q = group.y;
+    threadgroup float4 rq[64 * 4];
+    threadgroup float sq[64];
+    for (uint i = tid; i < heads * 4; i += 128) rq[i] = r[q * heads * 4 + i];
+    for (uint i = tid; i < heads; i += 128) sq[i] = sinks[q * heads + i];
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    const uint k = group.x * 128 + tid;
+    if (k >= keys) return;
+    const uint pos = q * keys + k;
+    const uint id = uint(ids[pos]);
+    const float c = float(causal[pos]);
+    float4 b0 = 0, b1 = 0, b2 = 0, b3 = 0;
+    if (id < extent) { b0 = bias[4 * id]; b1 = bias[4 * id + 1]; b2 = bias[4 * id + 2]; b3 = bias[4 * id + 3]; }
+    for (uint h = 0; h < heads; ++h) {
+        const float v = dot(b0, rq[4 * h]) + dot(b1, rq[4 * h + 1]) + dot(b2, rq[4 * h + 2]) + dot(b3, rq[4 * h + 3]);
+        output[(h * queries + q) * keys + k] = half(v - sq[h] + c);
+    }
+}
