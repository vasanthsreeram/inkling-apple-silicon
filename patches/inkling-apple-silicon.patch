+// ID: one route-map tile (one expert, <= 32 entries) x 64 weight rows per threadgroup.
+// Dense: 32 tokens x 64 weight rows. Bindings follow kernel_mul_mm_id, plus qa (6) and a8 args (7).
+template<short TYPE, bool ID>
+kernel void kernel_inkling_w4a8(
+        constant ggml_metal_kargs_mul_mm_id & args, device const char * weights,
+        device const char * input, device const uint * tiles, device const int * entries,
+        device float * output, device const char * qa, constant ggml_metal_kargs_inkling_a8 & a8,
+        threadgroup char * scratch [[threadgroup(0)]],
+        uint2 group [[threadgroup_position_in_grid]], ushort tid [[thread_index_in_threadgroup]]) {
+    (void) input;
+    uint expert = 0, first = 0, rows = 32;
+    if (ID) {
+        if (group.x >= tiles[0]) return;
+        expert = tiles[1 + group.x * 3];
+        first  = tiles[2 + group.x * 3];
+        rows   = min(tiles[3 + group.x * 3], 32u);
+    } else {
+        first = group.x * 32;
+        rows  = min(32u, (uint) args.ne1 - first);
+    }
+    const uint column = group.y * 64;
+    const int K = args.ne00, G = K / 32;
+
+    threadgroup int8_t * wa0 = (threadgroup int8_t *) scratch;
+    threadgroup int8_t * wa1 = wa0 + 64 * 32;
+    threadgroup int8_t * xb0 = wa1 + 64 * 32;
+    threadgroup int8_t * xb1 = xb0 + 32 * 32;
+    threadgroup float  * ws  = (threadgroup float *)(xb1 + 32 * 32); // [2][64]
+    threadgroup float  * wm  = ws + 128;                             // [2][64]
+    threadgroup float  * xs  = wm + 128;                             // [2][32]
+    threadgroup float  * xm  = xs + 64;                              // [2][32]
+
+    auto ta0 = tensor<threadgroup int8_t, dextents<int32_t, 2>, tensor_inline>(wa0, dextents<int32_t, 2>(32, 64));
+    auto ta1 = tensor<threadgroup int8_t, dextents<int32_t, 2>, tensor_inline>(wa1, dextents<int32_t, 2>(32, 64));
+    auto tb0 = tensor<threadgroup int8_t, dextents<int32_t, 2>, tensor_inline>(xb0, dextents<int32_t, 2>(32, 32));
+    auto tb1 = tensor<threadgroup int8_t, dextents<int32_t, 2>, tensor_inline>(xb1, dextents<int32_t, 2>(32, 32));
+    mpp::tensor_ops::matmul2d<mpp::tensor_ops::matmul2d_descriptor(32, 64, 32, false, true, false,
+        mpp::tensor_ops::matmul2d_descriptor::mode::multiply), execution_simdgroups<4>> mm;
+    auto ci = mm.template get_destination_cooperative_tensor<decltype(tb0), decltype(ta0), int32_t>();
+
+    constexpr int CAP = 16; // 32 x 64 outputs over 128 threads
+    float acc[CAP];
+    FOR_UNROLL (short i = 0; i < CAP; ++i) acc[i] = 0.0f;
+
+    // activation row this thread stages: token t = tid/4, 16-byte chunk c = tid%4
+    const short t = tid / 4, c = tid % 4;
+    int arow = -1;
+    if ((uint) t < rows) {
+        if (ID) {
+            const int id = entries[first + t];
+            arow = (id / args.ne20) * args.ne11 + (id % args.ne20) % args.ne11;
+        } else {
+            arow = first + t;
+        }
+    }
+    device const char * wrow = weights + args.nb02 * expert + args.nb01 * (column + tid / 2);
+    device const float * asc = (device const float *)(qa + a8.off_s);
+    device const float * asm_ = (device const float *)(qa + a8.off_m);
+
+    for (int k0 = 0; k0 < K; k0 += 64) {
+        inkling_stage_w<TYPE>(wrow, k0, tid / 2, tid % 2, wa0, wa1, ws, wm);
+        {
+            threadgroup int8_t * o = (c < 2 ? xb0 : xb1) + t * 32 + 16 * (c % 2);
+            uint4 v = 0;
+            if (arow >= 0) v = *(device const uint4 *)(qa + (uint64_t) arow * K + k0 + 16 * c);
+            *(threadgroup uint4 *) o = v;
+            if ((c % 2) == 0) {
+                const short s = c / 2;
+                xs[32 * s + t] = arow >= 0 ? asc [(uint64_t) arow * G + k0 / 32 + s] : 0.0f;
+                xm[32 * s + t] = arow >= 0 ? asm_[(uint64_t) arow * G + k0 / 32 + s] : 0.0f;
+            }
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        FOR_UNROLL (short s = 0; s < 2; ++s) {
+            auto bv = (s ? tb1 : tb0).slice(0, 0);
+            auto av = (s ? ta1 : ta0).slice(0, 0);
+            mm.run(bv, av, ci);
+            FOR_UNROLL (short i = 0; i < CAP; ++i) {
+                if (ci.is_valid_element(i)) {
+                    auto idx = ci.get_multidimensional_index(i);
+                    const int r = idx[0], tt = idx[1];
+                    acc[i] += ws[64 * s + r] * xs[32 * s + tt] * (float) ci[i] - wm[64 * s + r] * xm[32 * s + tt];
+                }
+            }
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+
+    threadgroup float * cst = (threadgroup float *) scratch; // [32 tokens][64 rows]
+    FOR_UNROLL (short i = 0; i < CAP; ++i) {
+        if (ci.is_valid_element(i)) {
+            auto idx = ci.get_multidimensional_index(i);
+            cst[idx[1] * 64 + idx[0]] = acc[i];
+        }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint job = tid; job < rows * 16; job += 128) {
+        const uint row = job / 16, offset = (job % 16) * 4;
+        device float * dest;
+        if (ID) {
+            const uint id = entries[first + row], lane = id % args.ne20, token = id / args.ne20;
+            dest = output + column + offset + (uint64_t(lane) + uint64_t(token) * args.ne1) * args.ne0;
+        } else {
+            dest = output + column + offset + uint64_t(first + row) * args.ne0;
+        }
+        *(device float4 *) dest = *(threadgroup float4 *)(cst + row * 64 + offset);
+    }
+}
