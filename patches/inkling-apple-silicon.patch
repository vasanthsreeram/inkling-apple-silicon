+// Fused single-token loop controller, part 1: z[r] = W[r] . concat(rms(cur), rms(msg)).
+// One 128-thread threadgroup per output row; every group recomputes the two RMS factors.
+template <typename T4>
+kernel void kernel_inkling_ctrl_down(
+        constant uint & h [[buffer(0)]], device const float4 * cur [[buffer(1)]],
+        device const float4 * msg [[buffer(2)]], device const T4 * w [[buffer(3)]],
+        device float * out [[buffer(4)]], uint row [[threadgroup_position_in_grid]],
+        ushort tid [[thread_index_in_threadgroup]], ushort simd [[simdgroup_index_in_threadgroup]],
+        ushort lane [[thread_index_in_simdgroup]]) {
+    threadgroup float part[4][4];
+    const uint n4 = h / 4;
+    device const T4 * wc = w + row * 2 * n4, * wm = wc + n4;
+    float sc = 0, sm = 0, ac = 0, am = 0;
+    for (uint i = tid; i < n4; i += 128) {
+        const float4 c = cur[i], m = msg[i];
+        sc += dot(c, c); sm += dot(m, m);
+        ac += dot(float4(wc[i]), c); am += dot(float4(wm[i]), m);
+    }
+    sc = simd_sum(sc); sm = simd_sum(sm); ac = simd_sum(ac); am = simd_sum(am);
+    if (lane == 0) { part[simd][0] = sc; part[simd][1] = sm; part[simd][2] = ac; part[simd][3] = am; }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (tid == 0) {
+        float t[4];
+        for (int k = 0; k < 4; ++k) t[k] = part[0][k] + part[1][k] + part[2][k] + part[3][k];
+        const float rc = 1.0f / sqrt(t[0] / h + 1e-6f), rm = 1.0f / sqrt(t[1] / h + 1e-6f);
+        out[row] = rc * t[2] + rm * t[3];
+    }
+}
