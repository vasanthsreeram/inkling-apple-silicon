+// Part 2: one SIMD group per hidden channel: gain and forget rows (64 wide) against z, then the merge.
+template <typename T2>
+kernel void kernel_inkling_ctrl_merge(
+        constant uint & h [[buffer(0)]], device const float * cur [[buffer(1)]],
+        device const float * msg [[buffer(2)]], device const float2 * z [[buffer(3)]],
+        device const T2 * wg [[buffer(4)]], device const T2 * wf [[buffer(5)]],
+        device float * out [[buffer(6)]], uint group [[threadgroup_position_in_grid]],
+        ushort simd [[simdgroup_index_in_threadgroup]], ushort lane [[thread_index_in_simdgroup]]) {
+    const uint row = group * 4 + simd;
+    if (row >= h) return;
+    const float2 zz = z[lane];
+    const float g = simd_sum(dot(float2(wg[row * 32 + lane]), zz));
+    const float f = simd_sum(dot(float2(wf[row * 32 + lane]), zz));
+    if (lane == 0) {
+        const float x = cur[row];
+        out[row] = (x - precise::tanh(f) * x) + precise::tanh(g) * msg[row];
+    }
+}
