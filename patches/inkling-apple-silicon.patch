+        tile = atomic_fetch_add_explicit((device atomic_uint *) descriptors, tiles, memory_order_relaxed);
+    }
+    base = simd_broadcast_first(base);
+    tile = simd_broadcast_first(tile);
+    for (uint i = lane; i < tiles; i += 32) {
