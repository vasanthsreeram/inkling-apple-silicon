+// ---------------------------------------------------------------------------------------------
+// Inkling W4A8 prefill: int8 activations x the file's own integer weight codes on the M5
+// neural accelerators (int8 x int8 -> int32), with the per-32 weight scale/minimum and
+// activation scale applied after each 32-wide block. Weights are read in their GGUF layout.
+// ---------------------------------------------------------------------------------------------
+#ifdef GGML_METAL_HAS_TENSOR
+kernel void kernel_inkling_quant_a8(
+        constant ggml_metal_kargs_inkling_a8 & args,
+        device const char * src1,
+        device       char * qa,
+        uint gid [[thread_position_in_grid]]) {
+    const int G = args.K / 32;
+    if ((int) gid >= args.nrows * G) return;
+    const int row = gid / G, g = gid % G;
+    const int i11 = row % args.ne11, i12 = row / args.ne11;
+    device const float4 * x = (device const float4 *)(src1 + args.nb12 * i12 + args.nb11 * i11) + g * 8;
+    float4 v[8];
+    float amax = 0.0f;
+    FOR_UNROLL (short i = 0; i < 8; ++i) { v[i] = x[i]; const float4 av = abs(v[i]); amax = max(amax, max(max(av.x, av.y), max(av.z, av.w))); }
+    const float d = amax / 127.0f;
+    const float id = amax > 0.0f ? 127.0f / amax : 0.0f;
+    device char4 * q = (device char4 *)(qa + (uint64_t) row * args.K + g * 32);
+    int sum = 0;
+    FOR_UNROLL (short i = 0; i < 8; ++i) {
+        const int4 c = clamp(int4(rint(v[i] * id)), -127, 127);
+        sum += c.x + c.y + c.z + c.w;
+        q[i] = char4(c);
+    }
+    ((device float *)(qa + args.off_s))[gid] = d;
+    ((device float *)(qa + args.off_m))[gid] = d * (float) sum;
+}
