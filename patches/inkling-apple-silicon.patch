+static inline float inkling_half(device const char * p) { return (float) *(device const half *) p; }
+
+// Stage 64 weight rows x 64 K values (two 32-blocks) as int8 codes plus per-block scale/minimum.
+// Thread layout: row = tid/2, h = tid%2 picks the 16-value half of each block (q4_K: of the byte run).
+template<short TYPE>
+static inline void inkling_stage_w(device const char * row, int k0, short r, short h,
+        threadgroup int8_t * wa0, threadgroup int8_t * wa1,
+        threadgroup float * ws, threadgroup float * wm) {
+    if (TYPE == 0) { // q4_K: 144-byte super-blocks of 256; byte i of pair p holds block 2p (low) and 2p+1 (high)
+        device const char * blk = row + (k0 / 256) * 144;
+        const short p = (k0 % 256) / 64;
+        device const uint * qs = (device const uint *)(blk + 16 + 32 * p + 16 * h);
+        threadgroup uint * o0 = (threadgroup uint *)(wa0 + r * 32 + 16 * h);
+        threadgroup uint * o1 = (threadgroup uint *)(wa1 + r * 32 + 16 * h);
+        FOR_UNROLL (short i = 0; i < 4; ++i) {
+            const uint w = qs[i];
+            o0[i] = w & 0x0F0F0F0Fu;
+            o1[i] = (w >> 4) & 0x0F0F0F0Fu;
+        }
+        if (h == 0) {
+            const float d = inkling_half(blk), dmin = inkling_half(blk + 2);
+            device const uchar * sc = (device const uchar *)(blk + 4);
+            const uchar2 a = get_scale_min_k4_just2(2 * p, 0, sc);
+            const uchar2 b = get_scale_min_k4_just2(2 * p + 1, 0, sc);
+            ws[r] = d * a.x; wm[r] = dmin * a.y;
+            ws[64 + r] = d * b.x; wm[64 + r] = dmin * b.y;
+        }
+    } else if (TYPE == 1) { // q5_0: 22-byte blocks of 32, w = d * (q - 16)
+        FOR_UNROLL (short s = 0; s < 2; ++s) {
+            device const uchar * blk = (device const uchar *)(row + (k0 / 32 + s) * 22);
+            const uint qh = uint(blk[2]) | (uint(blk[3]) << 8) | (uint(blk[4]) << 16) | (uint(blk[5]) << 24);
+            threadgroup int8_t * o = (s ? wa1 : wa0) + r * 32 + 16 * h;
+            FOR_UNROLL (short j = 0; j < 16; ++j) {
+                const uchar q = blk[6 + j];
+                const int v = h == 0 ? ((q & 0xF) | (((qh >> j) << 4) & 0x10)) : ((q >> 4) | ((qh >> (j + 12)) & 0x10));
+                o[j] = (int8_t)(v - 16);
+            }
+            if (h == 0) { ws[64 * s + r] = (float) *(device const half *) blk; wm[64 * s + r] = 0.0f; }
+        }
+    } else { // q8_0: 34-byte blocks of 32, w = d * q
+        FOR_UNROLL (short s = 0; s < 2; ++s) {
+            device const char * blk = row + (k0 / 32 + s) * 34;
+            device const ushort * q = (device const ushort *)(blk + 2 + 16 * h);
+            threadgroup ushort * o = (threadgroup ushort *)((s ? wa1 : wa0) + r * 32 + 16 * h);
+            FOR_UNROLL (short j = 0; j < 8; ++j) o[j] = q[j];
+            if (h == 0) { ws[64 * s + r] = inkling_half(blk); wm[64 * s + r] = 0.0f; }
+        }
+    }
+}
