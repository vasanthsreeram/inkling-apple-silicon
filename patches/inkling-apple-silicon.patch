+// Warp-specialized with 8 producer SIMD groups (4-11) that dequantize the next K strip while groups 0-3 run the accelerator on the current one.
+template<int KT, typename W, short chunks, void (*dequant)(device const W *, short, thread half4x4 &)>
+kernel void kernel_inkling_moe64wp(
+        constant ggml_metal_kargs_mul_mm_id & args, device const char * weights,
+        device const char * input, device const uint * tiles, device const int * entries,
+        device float * output, threadgroup char * scratch [[threadgroup(0)]],
+        uint2 group [[threadgroup_position_in_grid]], uint tid_all [[thread_index_in_threadgroup]]) {
+    const bool producer = tid_all >= 128;
+    const uint tid = producer ? tid_all - 128 : tid_all;
+    if (group.x >= tiles[0]) return;
+    const uint expert = tiles[1 + group.x * 3];
+    const uint first = tiles[2 + group.x * 3];
+    const uint rows = min(tiles[3 + group.x * 3], 64u);
+    const uint column = group.y * 64;
+    const uint K = args.ne00;
+    threadgroup half * a0 = (threadgroup half *)scratch;
+    threadgroup half * a1 = a0 + 64 * KT;
+    threadgroup half * b0 = a1 + 64 * KT;
+    threadgroup half * b1 = b0 + 64 * KT;
+    auto ta0 = tensor<threadgroup half, dextents<int32_t, 2>, tensor_inline>(a0, dextents<int32_t, 2>(KT, 64));
+    auto ta1 = tensor<threadgroup half, dextents<int32_t, 2>, tensor_inline>(a1, dextents<int32_t, 2>(KT, 64));
+    auto tb0 = tensor<threadgroup half, dextents<int32_t, 2>, tensor_inline>(b0, dextents<int32_t, 2>(KT, 64));
+    auto tb1 = tensor<threadgroup half, dextents<int32_t, 2>, tensor_inline>(b1, dextents<int32_t, 2>(KT, 64));
+    mpp::tensor_ops::matmul2d<mpp::tensor_ops::matmul2d_descriptor(64, 64, KT, false, true, false,
+        mpp::tensor_ops::matmul2d_descriptor::mode::multiply_accumulate), execution_simdgroups<4>> mm;
+    auto c0 = mm.template get_destination_cooperative_tensor<decltype(ta0), decltype(tb0), float>();
+    constexpr uint chunks_a = KT / 16;
+    constexpr uint chunks_b = KT / 8;
+    constexpr uint NA = (64 * chunks_a + 255) / 256, NB = (64 * chunks_b + 255) / 256;
+    device const W * wrow[NA];
+    uint woff[NA], wdst[NA];
+    FOR_UNROLL (uint j = 0; j < NA; ++j) {
+        const uint job = min(tid + 256 * j, 64 * chunks_a - 1), col = job / chunks_a;
+        wrow[j] = (device const W *)(weights + args.nb02 * expert + args.nb01 * (column + col));
+        woff[j] = (job % chunks_a) * 16;
+        wdst[j] = col * KT + woff[j];
+    }
+    device const float * xrow[NB];
+    uint xdst[NB];
+    FOR_UNROLL (uint j = 0; j < NB; ++j) {
+        const uint job = min(tid + 256 * j, 64 * chunks_b - 1), row = min(job / chunks_b, rows - 1);
+        const uint id = entries[first + row];
+        xrow[j] = (device const float *)(input + args.nb12 * (id / args.ne20) + args.nb11 * ((id % args.ne20) % args.ne11)) + (job % chunks_b) * 8;
