+    for (int64_t row = ith; row < queries * heads; row += nth) {
+        const int64_t q = row % queries, h = row / queries;
+        const float * rv = r + 16 * (q * heads + h);
+        for (int64_t k = 0; k < keys; ++k) {
+            const int64_t pos = q * keys + k;
+            const int32_t id = ids[pos];
+            float b = 0.0f;
+            if (id < extent) for (int i = 0; i < 16; ++i) b += rv[i] * bias[16 * id + i];
+            result[row * keys + k] = ggml_fp32_to_fp16(b - sinks[q * heads + h] + ggml_fp16_to_fp32(causal[pos]));
