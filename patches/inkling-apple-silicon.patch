+kernel void kernel_inkling_route_map(constant uint & entries, device const int * routes,
+                                     device uint * descriptors, device int * compact,
+                                     device atomic_uint * entry_count,
+                                     uint expert [[threadgroup_position_in_grid]],
+                                     uint lane [[thread_index_in_simdgroup]]) {
