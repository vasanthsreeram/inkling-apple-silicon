+}
+static inline bool ggml_is_inkling_situ(const struct ggml_tensor * op) {
+    return op->op == GGML_OP_CUSTOM && op->op_params[GGML_INKLING_TAG_SLOT] == GGML_INKLING_SITU_TAG &&
+        ggml_inkling_situ_inputs(op->src[0], op->src[1]) && op->type == GGML_TYPE_F32 &&
+        ggml_is_contiguous(op) && ggml_are_same_shape(op, op->src[0]);
+}
+
+#define GGML_INKLING_CLIP_TAG 0x49434c50
+static inline bool ggml_inkling_clip_input(const struct ggml_tensor * x) {
+    return x && x->type == GGML_TYPE_F32 && x->ne[0] >= 4 && x->ne[0] <= 128 &&
+        x->ne[0] % 4 == 0 && ggml_is_contiguous(x);
+}
+static inline bool ggml_is_inkling_clip(const struct ggml_tensor * x) {
+    return x->op == GGML_OP_CUSTOM && x->op_params[GGML_INKLING_TAG_SLOT] == GGML_INKLING_CLIP_TAG &&
+        ggml_inkling_clip_input(x->src[0]) && ggml_are_same_shape(x, x->src[0]) &&
+        x->type == GGML_TYPE_F32 && ggml_is_contiguous(x);
+}
+
+#define GGML_INKLING_GATE_TAG 0x49474154
+static inline bool ggml_inkling_gate_inputs(struct ggml_tensor * const * args) {
+    for (int i = 0; i < 4; ++i) {
+        if (!args[i] || args[i]->type != GGML_TYPE_F32 || !ggml_is_contiguous(args[i]) ||
+            !ggml_are_same_shape(args[0], args[i])) return false;
+    }
+    return args[0]->ne[0] % 4 == 0;
+}
+static inline bool ggml_is_inkling_gate_merge(const struct ggml_tensor * op) {
+    return op->op == GGML_OP_CUSTOM && op->op_params[GGML_INKLING_TAG_SLOT] == GGML_INKLING_GATE_TAG &&
+        ggml_inkling_gate_inputs(op->src) && op->type == GGML_TYPE_F32 && ggml_is_contiguous(op) &&
+        ggml_are_same_shape(op, op->src[0]);
+}
+
+#define GGML_INKLING_CONV_TAG 0x49434e56
+static inline bool ggml_inkling_conv_inputs(const struct ggml_tensor * x, const struct ggml_tensor * w,
+                                           const struct ggml_tensor * cur, const struct ggml_tensor * taps) {
+    if (!x || !w || !cur || x->type != GGML_TYPE_F32 || w->type != GGML_TYPE_F32 || cur->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(x) || !ggml_is_contiguous(w) || !ggml_is_contiguous(cur) ||
+        !ggml_is_matrix(x) || !ggml_is_matrix(w) || !ggml_is_matrix(cur) || w->ne[0] != 4 ||
+        w->ne[1] != cur->ne[0] || x->ne[0] != cur->ne[1] + 3 || x->ne[1] != cur->ne[0]) return false;
+    return !taps || (taps->type == GGML_TYPE_F32 && ggml_is_matrix(taps) && ggml_is_contiguous(taps) &&
+        taps->ne[1] == cur->ne[1] && taps->ne[0] > 0 && taps->ne[0] % 4 == 0 && cur->ne[0] % (taps->ne[0] / 4) == 0);
+}
+static inline bool ggml_is_inkling_conv(const struct ggml_tensor * op) {
+    return op->op == GGML_OP_CUSTOM && op->op_params[GGML_INKLING_TAG_SLOT] == GGML_INKLING_CONV_TAG &&
+        ggml_inkling_conv_inputs(op->src[0], op->src[1], op->src[2], op->src[3]) && op->type == GGML_TYPE_F32 &&
+        ggml_is_contiguous(op) && ggml_are_same_shape(op, op->src[2]);
+}
+
+// Relative bias computed in the mask: srcs { bias [R, E], r [R, H, T], sinks [1, H, T], ids [K, T], causal [K, T] }.
+// out[k, q, h] = (ids < E ? dot(r[:, h, q], bias[:, ids]) : 0) - sinks[h, q] + causal[k, q], in F16.
+#define GGML_INKLING_RELB_TAG 0x4952424d
+static inline bool ggml_is_inkling_relative_bias_mask(const struct ggml_tensor * op) {
+    if (op->op != GGML_OP_CUSTOM || op->op_params[GGML_INKLING_TAG_SLOT] != GGML_INKLING_RELB_TAG) return false;
+    const struct ggml_tensor * bias = op->src[0], * r = op->src[1], * sinks = op->src[2], * ids = op->src[3], * mask = op->src[4];
+    return bias && r && sinks && ids && mask && op->type == GGML_TYPE_F16 && bias->type == GGML_TYPE_F32 &&
+        r->type == GGML_TYPE_F32 && sinks->type == GGML_TYPE_F32 && ids->type == GGML_TYPE_I32 && mask->type == GGML_TYPE_F16 &&
+        ggml_is_contiguous(bias) && ggml_is_contiguous(r) && ggml_is_contiguous(sinks) && ggml_is_contiguous(ids) &&
+        ggml_is_contiguous(mask) && ggml_is_contiguous(op) && bias->ne[0] == 16 && r->ne[0] == 16 &&
+        r->ne[1] == op->ne[2] && r->ne[2] == op->ne[1] && r->ne[1] <= 64 && ggml_nelements(sinks) == r->ne[1] * r->ne[2] &&
+        op->ne[3] == 1 && mask->ne[0] == op->ne[0] && mask->ne[1] == op->ne[1] && mask->ne[2] == 1 && mask->ne[3] == 1 &&
+        ggml_are_same_shape(ids, mask);
+}
+
+// Fused single-token loop controller (decode).
+//   down:  srcs { cur [H, 1], msg [H, 1], W [2H, R] }           out z [R, 1] = W . concat(rms(cur), rms(msg))
+//   merge: srcs { cur [H, 1], msg [H, 1], z [64, 1], Wg [64, H], Wf [64, H] }
+//          out [H, 1] = (cur - tanh(Wf . z) * cur) + tanh(Wg . z) * msg
+// Weights are F32 or F16, rms uses eps 1e-6.
+#define GGML_INKLING_CDOWN_TAG 0x4943444e
+#define GGML_INKLING_CMERGE_TAG 0x49434d47
+static inline bool ggml_inkling_ctrl_vec(const struct ggml_tensor * t, int64_t n) {
+    return t && t->type == GGML_TYPE_F32 && ggml_is_contiguous(t) && t->ne[0] == n && ggml_nelements(t) == n;
+}
+static inline bool ggml_inkling_ctrl_weight(const struct ggml_tensor * w, int64_t k, int64_t rows) {
+    return w && (w->type == GGML_TYPE_F32 || w->type == GGML_TYPE_F16) && ggml_is_contiguous(w) &&
+        w->ne[0] == k && w->ne[1] == rows && w->ne[2] == 1 && w->ne[3] == 1;
+}
+static inline bool ggml_inkling_ctrl_down_inputs(struct ggml_tensor * const * a) {
+    const int64_t h = a[0] ? a[0]->ne[0] : 0;
+    return h > 0 && h % 4 == 0 && ggml_inkling_ctrl_vec(a[0], h) && ggml_inkling_ctrl_vec(a[1], h) &&
+        a[2] && ggml_inkling_ctrl_weight(a[2], 2 * h, a[2]->ne[1]);
+}
+static inline bool ggml_inkling_ctrl_merge_inputs(struct ggml_tensor * const * a) {
+    const int64_t h = a[0] ? a[0]->ne[0] : 0;
+    return h > 0 && ggml_inkling_ctrl_vec(a[0], h) && ggml_inkling_ctrl_vec(a[1], h) && ggml_inkling_ctrl_vec(a[2], 64) &&
+        ggml_inkling_ctrl_weight(a[3], 64, h) && ggml_inkling_ctrl_weight(a[4], 64, h) && a[3]->type == a[4]->type;
+}
+static inline bool ggml_is_inkling_ctrl_down(const struct ggml_tensor * op) {
+    return op->op == GGML_OP_CUSTOM && op->op_params[GGML_INKLING_TAG_SLOT] == GGML_INKLING_CDOWN_TAG &&
+        ggml_inkling_ctrl_down_inputs(op->src) && ggml_inkling_ctrl_vec(op, op->src[2]->ne[1]);
+}
+static inline bool ggml_is_inkling_ctrl_merge(const struct ggml_tensor * op) {
+    return op->op == GGML_OP_CUSTOM && op->op_params[GGML_INKLING_TAG_SLOT] == GGML_INKLING_CMERGE_TAG &&
+        ggml_inkling_ctrl_merge_inputs(op->src) && ggml_inkling_ctrl_vec(op, op->src[0]->ne[0]);
+}
+
+// Single-token short convolution that also advances the recurrent state in place.
+// srcs { past [3*C] (gathered copy of the state), w [4, C], cur [C], cell [3*C] (state slot, written), taps [4*heads]? }
+#define GGML_INKLING_CONV1_TAG 0x49435631
+static inline bool ggml_is_inkling_conv_step(const struct ggml_tensor * op) {
+    if (op->op != GGML_OP_CUSTOM || op->op_params[GGML_INKLING_TAG_SLOT] != GGML_INKLING_CONV1_TAG) return false;
+    const struct ggml_tensor * past = op->src[0], * w = op->src[1], * cur = op->src[2], * cell = op->src[3], * taps = op->src[4];
+    if (!past || !w || !cur || !cell || op->type != GGML_TYPE_F32 || !ggml_is_contiguous(op)) return false;
+    const int64_t c = cur->ne[0];
+    if (ggml_nelements(cur) != c || ggml_nelements(op) != c || ggml_nelements(past) != 3 * c || ggml_nelements(cell) != 3 * c ||
+        w->ne[0] != 4 || w->ne[1] != c) return false;
+    const struct ggml_tensor * dense[4] = { past, w, cur, cell };
+    for (int i = 0; i < 4; ++i) {
+        if (dense[i]->type != GGML_TYPE_F32 || !ggml_is_contiguous(dense[i])) return false;
+    }
+    return !taps || (taps->type == GGML_TYPE_F32 && ggml_is_contiguous(taps) && ggml_nelements(taps) % 4 == 0 &&
+        c % (ggml_nelements(taps) / 4) == 0);
+}
