+// Inkling W4A8: quantize src1 into the op's scratch, then run the int8 neural-accelerator kernel.
+static ggml_metal_kargs_inkling_a8 inkling_a8_args(const ggml_tensor * op, ggml_metal_buffer_id & bid_qa) {
+    bid_qa.offs = (bid_qa.offs + 15) & ~(size_t) 15;
+    const int64_t K = op->src[0]->ne[0];
+    const int64_t nrows = op->src[1]->ne[1] * op->src[1]->ne[2];
+    ggml_metal_kargs_inkling_a8 a8 = {
+        /*.K     =*/ (int32_t) K,
+        /*.ne11  =*/ (int32_t) op->src[1]->ne[1],
+        /*.nrows =*/ (int32_t) nrows,
+        /*.nb11  =*/ op->src[1]->nb[1],
+        /*.nb12  =*/ op->src[1]->nb[2],
+        /*.off_s =*/ (uint64_t) (nrows * K),
+        /*.off_m =*/ (uint64_t) (nrows * K + nrows * (K / 32) * sizeof(float)),
+    };
+    return a8;
+}
+
+static void inkling_a8_quant(ggml_metal_op_t ctx, const ggml_tensor * op, const ggml_metal_kargs_inkling_a8 & a8, ggml_metal_buffer_id bid_qa) {
+    auto pipeline = ggml_metal_library_get_pipeline(ctx->lib, "kernel_inkling_quant_a8");
+    if (!pipeline.pipeline) pipeline = ggml_metal_library_compile_pipeline(ctx->lib, "kernel_inkling_quant_a8", "kernel_inkling_quant_a8", nullptr);
+    ggml_metal_encoder_set_pipeline(ctx->enc, pipeline);
+    ggml_metal_encoder_set_bytes   (ctx->enc, (void *) &a8, sizeof(a8), 0);
+    ggml_metal_encoder_set_buffer  (ctx->enc, ggml_metal_get_buffer_id(op->src[1]), 1);
+    ggml_metal_encoder_set_buffer  (ctx->enc, bid_qa, 2);
+    const int n = a8.nrows * (a8.K / 32);
+    ggml_metal_encoder_dispatch_threadgroups(ctx->enc, (n + 255) / 256, 1, 1, 256, 1, 1);
+}
