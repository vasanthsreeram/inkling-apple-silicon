+    }
+#define INKLING_MOE64_LOAD(A, B, k) \
+    FOR_UNROLL (uint j = 0; j < NA; ++j) if (tid + 256 * j < 64 * chunks_a) { \
+        const uint chunk = ((k) + woff[j]) / 16; half4x4 values; \
+        dequant(wrow[j] + chunk / chunks, short(chunk % chunks), values); \
+        threadgroup half4 * target = (threadgroup half4 *)((A) + wdst[j]); \
+        FOR_UNROLL (short v = 0; v < 4; ++v) target[v] = values[v]; \
+    } \
+    FOR_UNROLL (uint j = 0; j < NB; ++j) if (tid + 256 * j < 64 * chunks_b) { \
+        device const float4 * src = (device const float4 *)(xrow[j] + (k)); \
+        threadgroup half4 * target = (threadgroup half4 *)((B) + xdst[j]); \
+        target[0] = half4(src[0]); target[1] = half4(src[1]); \
+    }
+    if (producer) { INKLING_MOE64_LOAD(a0, b0, 0) }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint k = 0; k < K; k += 2 * KT) {
+        if (!producer) {
+            auto av = ta0.slice(0, 0); auto bv = tb0.slice(0, 0);
+            mm.run(bv, av, c0);
+        } else if (k + KT < K) { INKLING_MOE64_LOAD(a1, b1, k + KT) }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (k + KT >= K) break;
+        if (!producer) {
+            auto av = ta1.slice(0, 0); auto bv = tb1.slice(0, 0);
+            mm.run(bv, av, c0);
+        } else if (k + 2 * KT < K) { INKLING_MOE64_LOAD(a0, b0, k + 2 * KT) }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+#undef INKLING_MOE64_LOAD
+    threadgroup float * c = (threadgroup float *)scratch;
+    if (!producer) {
+        auto tc = tensor<threadgroup float, dextents<int32_t, 2>, tensor_inline>(c, dextents<int32_t, 2>(64, 64));
+        c0.store(tc);
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint job = tid_all; job < rows * 16; job += 384) {
+        const uint row = job / 16, offset = (job % 16) * 4;
+        const uint id = entries[first + row], lane = id % args.ne20, token = id / args.ne20;
+        device float * dest = output + column + offset + (uint64_t(lane) + uint64_t(token) * args.ne1) * args.ne0;
+        *(device float4 *)dest = *(threadgroup float4 *)(c + row * 64 + offset);
+    }
+}
