+static void inkling_depth_mix_cpu(ggml_tensor * dst, int ith, int nth, void *) {
+    const int width = dst->ne[0], tokens = dst->ne[1], queries = dst->ne[2];
+    const int count = dst->op_params[GGML_INKLING_COUNT_SLOT];
+    const float scale = 1.0f / std::sqrt(float(width));
+    for (int row = ith; row < queries * tokens; row += nth) {
+        const int token = row / queries;
+        const float * q = (const float *) dst->src[0]->data + (row % queries) * width;
+        float norm[GGML_INKLING_DEPTH_MAX], score[GGML_INKLING_DEPTH_MAX];
+        float maximum = -INFINITY;
+        for (int s = 0; s < count; ++s) {
+            const float * x = (const float *) dst->src[s + 1]->data + token * width;
+            float squared = 0, product = 0;
+            for (int i = 0; i < width; ++i) {
+                squared += x[i] * x[i];
+                product += x[i] * q[i];
+            }
+            norm[s] = 1.0f / std::sqrt(squared / width + 1e-6f);
+            score[s] = product * norm[s] * scale;
+            maximum = std::max(maximum, score[s]);
+        }
+        float total = 0;
+        for (int s = 0; s < count; ++s) {
+            score[s] = std::exp(score[s] - maximum);
+            total += score[s];
+        }
+        float * out = (float *) dst->data + ((row % queries) * tokens + token) * width;
+        std::fill(out, out + width, 0.0f);
+        for (int s = 0; s < count; ++s) {
+            const float * x = (const float *) dst->src[s + 1]->data + token * width;
+            const float weight = score[s] / total * norm[s];
+            for (int i = 0; i < width; ++i) out[i] += weight * x[i];
+        }
+    }
+}
