+// Inkling W4A8: which weight type the int8 prefill kernel handles for this op (0 q4_K,
+// 1 q5_0, 2 q8_0), or -1. Shared by buffer sizing and dispatch so both agree.
+int ggml_metal_op_inkling_w4a8(const struct ggml_tensor * op) {
+    static const bool on = std::getenv("INKLING_W4A8") != nullptr;
+    if (!on) return -1;
+    if (op->op != GGML_OP_MUL_MAT && op->op != GGML_OP_MUL_MAT_ID) return -1;
+    const ggml_tensor * a = op->src[0];
+    const ggml_tensor * b = op->src[1];
+    if (b->type != GGML_TYPE_F32 || b->nb[0] != sizeof(float) || b->nb[1] % 16 || b->nb[2] % 16) return -1;
+    if (ggml_is_transposed(a) || ggml_is_transposed(b) || a->ne[3] != 1 || b->ne[3] != 1) return -1;
+    const int64_t K = a->ne[0];
+    int type = -1;
+    switch (a->type) {
+        case GGML_TYPE_Q4_K: type = K % 256 == 0 ? 0 : -1; break;
+        case GGML_TYPE_Q5_0: type = K % 64  == 0 ? 1 : -1; break;
+        case GGML_TYPE_Q8_0: type = K % 64  == 0 ? 2 : -1; break;
