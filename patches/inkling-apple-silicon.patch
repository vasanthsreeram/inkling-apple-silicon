+kernel void kernel_inkling_shortconv(
+        constant uint * shape [[buffer(0)]], constant float & scale [[buffer(1)]],
+        device const float * history [[buffer(2)]], device const float4 * weights [[buffer(3)]],
+        device const float * cur [[buffer(4)]], device const float4 * taps [[buffer(5)]],
+        device float * out [[buffer(6)]], uint i [[thread_position_in_grid]]) {
+    const uint channels = shape[0], tokens = shape[1], heads = shape[2];
+    if (i >= channels * tokens) return;
+    const uint c = i % channels, t = i / channels;
+    device const float * x = history + c * (tokens + 3) + t;
+    const float4 window = float4(x[0], x[1], x[2], x[3]);
+    volatile thread float value = dot(window, weights[c]);
+    if (heads) {
+        const float4 coeff = taps[t * heads + c / (channels / heads)];
+        volatile thread float4 terms = window.wzyx * coeff;
+        value = value + terms.x;
+        value = value + terms.y;
+        value = value + terms.z;
+        value = value + terms.w;
+    }
+    volatile thread float with_residual = cur[i] + value;
+    out[i] = with_residual * scale;
