+kernel void kernel_inkling_gate_merge(
+        constant uint & count [[buffer(0)]], device const float4 * cur [[buffer(1)]],
+        device const float4 * msg [[buffer(2)]], device const float4 * gain [[buffer(3)]],
+        device const float4 * forget [[buffer(4)]], device float4 * out [[buffer(5)]],
+        uint i [[thread_position_in_grid]]) {
+    #pragma clang fp reassociate(off) contract(off)
+    if (i >= count) return;
+    const float4 x = cur[i];
+    volatile thread float4 kept = precise::tanh(forget[i]) * x;
+    volatile thread float4 added = precise::tanh(gain[i]) * msg[i];
+    volatile thread float4 rest = x - kept;
+    out[i] = rest + added;
+}
