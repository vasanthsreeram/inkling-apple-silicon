+// Each SIMD group handles a residual state for one token and one query.
+// Reduce RMS and query dot products together, then mix the original vectors.
+kernel void kernel_inkling_depth_mix(
+        constant int * args [[buffer(0)]], device const float4 * queries [[buffer(1)]],
+        device const float4 * s0 [[buffer(2)]], device const float4 * s1 [[buffer(3)]],
+        device const float4 * s2 [[buffer(4)]], device const float4 * s3 [[buffer(5)]],
+        device const float4 * s4 [[buffer(6)]], device const float4 * s5 [[buffer(7)]],
+        device float4 * dst [[buffer(8)]], uint2 group [[threadgroup_position_in_grid]],
+        uint lane [[thread_index_in_simdgroup]], uint state [[simdgroup_index_in_threadgroup]],
+        uint tid [[thread_index_in_threadgroup]]) {
+    device const float4 * states[6] = {s0, s1, s2, s3, s4, s5};
+    const uint width = args[0], vectors = width / 4, count = args[2];
+    const uint offset = group.y * vectors;
+    device const float4 * x = states[state] + offset;
+    device const float4 * q = queries + group.x * vectors;
+    float squared = 0, product = 0;
+    for (uint i = lane; i < vectors; i += 32) {
+        const float4 v = x[i];
+        squared += dot(v, v);
+        product += dot(v, q[i]);
+    }
+    threadgroup float norm[6], scores[6];
+    const float inv_rms = rsqrt(simd_sum(squared) / float(width) + 1e-6f);
+    const float score = simd_sum(product) * inv_rms * rsqrt(float(width));
+    if (lane == 0) {
+        norm[state] = inv_rms;
+        scores[state] = score;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (state == 0) {
+        const float maximum = simd_max(lane < count ? scores[lane] : -INFINITY);
+        const float e = lane < count ? exp(scores[lane] - maximum) : 0;
+        const float total = simd_sum(e);
+        if (lane < count) scores[lane] = e / total * norm[lane];
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    dst += (group.x * args[1] + group.y) * vectors;
+    for (uint i = tid; i < vectors; i += 32 * count) {
+        float4 acc = 0;
+        for (uint s = 0; s < count; ++s) acc += scores[s] * states[s][offset + i];
+        dst[i] = acc;
+    }
+}
